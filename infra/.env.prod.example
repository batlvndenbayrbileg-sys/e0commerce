# NARAN production env — copy to infra/.env and fill in.
# infra/.env is gitignored. NEVER commit real secrets (QPay, R2, DB password).

# --- Database ---
# On-box Postgres (docker-compose.prod.yml) — set these three:
POSTGRES_USER=naran
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=naran
# Managed Postgres (docker-compose.managed-db.yml) — set the FULL connection
# string instead (from Neon/DO). Must include ?sslmode=require. Leave blank when
# using the on-box compose above.
DATABASE_URL=

# --- Medusa secrets (generate: openssl rand -base64 32) ---
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# --- MeiliSearch (use a strong admin/master key) ---
MEILISEARCH_API_KEY=change-me-meili-master-key

# --- Public domains allowed to call Medusa (comma-separated, https) ---
STORE_CORS=https://naran.mn,https://www.naran.mn
ADMIN_CORS=https://admin.naran.mn,https://api.naran.mn
AUTH_CORS=https://naran.mn,https://www.naran.mn,https://admin.naran.mn

# --- Storefront build-time public config ---
# NEXT_PUBLIC_MEDUSA_URL = the PUBLIC Medusa domain the browser hits.
NEXT_PUBLIC_MEDUSA_URL=https://api.naran.mn
# Publishable key + region id from your seeded DB (SELECT token FROM api_key; SELECT id FROM region;).
NEXT_PUBLIC_MEDUSA_PK=pk_replace_me
NEXT_PUBLIC_MEDUSA_REGION=reg_replace_me
NEXT_PUBLIC_MEILISEARCH=1

# --- Express payment gateway (Wire → QPay & bank apps) ---
# Public storefront origin (used for post-payment redirects).
PUBLIC_SITE_URL=https://naran.mn
# Blank WIRE_SECRET_KEY → MOCK mode (auto-succeeds, for demo). Set your real
# wire.mn key to go live (sk_test_… = sandbox, sk_live_… = production).
WIRE_SECRET_KEY=
WIRE_WEBHOOK_SECRET=
# Email (Resend) — order confirmations.
RESEND_API_KEY=
EMAIL_FROM=NARAN <onboarding@resend.dev>

# --- Optional: Cloudflare R2 image storage (blank → local files) ---
S3_FILE_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Analytics (optional; blank → disabled) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Error monitoring (Sentry, optional) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- e-Barimt (НӨАТ, optional; blank = MOCK) ---
EBARIMT_URL=
EBARIMT_MERCHANT_TIN=
EBARIMT_DISTRICT_CODE=
