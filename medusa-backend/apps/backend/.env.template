STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# --- MeiliSearch (optional; enables typo-tolerant faceted product search) ---
# Leave blank to disable — Medusa falls back to built-in `q` search.
# On the VPS run MeiliSearch and point these at it (use a master/admin key here).
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# --- Cloudflare R2 / S3 image storage (optional) ---
# Leave S3_ENDPOINT + S3_BUCKET blank to use local file storage (dev default).
# NEVER commit real keys — set them only in the VPS environment.
S3_FILE_URL=            # public base URL for objects (e.g. https://cdn.naran.mn)
S3_ENDPOINT=            # https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=              # e.g. naran-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto          # R2 uses "auto"
